generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  OWNER
  ADMIN
}

enum ListingStatus {
  PENDENTE
  APROVADO
  REPROVADO
  INATIVO
}

enum MediaType {
  FOTO
  LOGO
  VIDEO
}

enum SubscriptionStatus {
  NONE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model City {
  id            String         @id @default(cuid())
  nome          String
  uf            String
  slug          String?        @unique
  ativa         Boolean        @default(false)
  listings      Listing[]
  professionals Professional[]

  @@unique([nome, uf])
}

model Category {
  id            String         @id @default(cuid())
  nome          String
  slug          String         @unique
  icone         String?
  subcategories Subcategory[]
  listings      Listing[]
  professionals Professional[]
}

model Subcategory {
  id            String         @id @default(cuid())
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id])
  nome          String
  slug          String
  listings      Listing[]
  professionals Professional[]

  @@unique([categoryId, slug])
}

model User {
  id                   String              @id @default(cuid())
  nome                 String
  email                String              @unique
  senhaHash            String?
  role                 Role                @default(USER)
  emailVerificado      Boolean             @default(false)
  criadoEm             DateTime            @default(now())
  listings             Listing[]
  professionals        Professional[]
  reviews              Review[]

  stripeCustomerId     String?             @unique
  stripeSubscriptionId String?             @unique
  subscriptionStatus   SubscriptionStatus  @default(NONE)
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
}

model Listing {
  id                    String        @id @default(cuid())
  codigoPublico         String        @unique
  ownerId               String
  owner                 User          @relation(fields: [ownerId], references: [id])
  cityId                String
  city                  City          @relation(fields: [cityId], references: [id])
  categoryId            String
  category              Category      @relation(fields: [categoryId], references: [id])
  subcategoryId         String?
  subcategory           Subcategory?  @relation(fields: [subcategoryId], references: [id])

  nome                  String
  cnpj                  String?       @unique
  descricao             String
  telefone              String?
  telefoneFixo          String?
  whatsapp              String?
  instagram             String?
  facebook              String?
  site                  String?
  email                 String?
  valorHora             String?

  endereco              String
  lat                   Float?
  lng                   Float?

  aceitaPix             Boolean       @default(false)
  aceitaCartao          Boolean       @default(false)
  entrega               Boolean       @default(false)
  atendimentoDomiciliar Boolean       @default(false)

  status                ListingStatus @default(PENDENTE)
  motivoReprovacao      String?

  horario               String?

  criadoEm              DateTime      @default(now())
  atualizadoEm          DateTime      @updatedAt

  media                 Media[]
  products              Product[]
  reviews               Review[]

  @@index([status])
  @@index([cityId, categoryId])
}

model Professional {
  id               String        @id @default(cuid())
  codigoPublico    String        @unique
  ownerId          String
  owner            User          @relation(fields: [ownerId], references: [id])
  cityId           String
  city             City          @relation(fields: [cityId], references: [id])
  categoryId       String
  category         Category      @relation(fields: [categoryId], references: [id])
  subcategoryId    String?
  subcategory      Subcategory?  @relation(fields: [subcategoryId], references: [id])

  nome             String
  cpfCriptografado String        // nunca exposto em API pública (AES-256-GCM, reversível só p/ admin)
  cpfHash          String        @unique // HMAC-SHA256 determinístico, só p/ checar CPF duplicado
  dataNascimento   DateTime      // privado — só dono/admin
  whatsapp         String
  email            String?
  instagram        String?
  facebook         String?
  descricao        String
  bairroAtuacao    String?
  valorHora        String?

  status           ListingStatus @default(PENDENTE)
  motivoReprovacao String?

  criadoEm         DateTime      @default(now())
  atualizadoEm     DateTime      @updatedAt

  media            Media[]
  products         Product[]
  reviews          Review[]

  @@index([status])
  @@index([cityId, categoryId])
}

model Media {
  id             String        @id @default(cuid())
  listingId      String?
  listing        Listing?      @relation(fields: [listingId], references: [id])
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id])
  tipo           MediaType
  url            String
  ordem          Int           @default(0)
}

model Product {
  id             String        @id @default(cuid())
  listingId      String?
  listing        Listing?      @relation(fields: [listingId], references: [id])
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id])
  nome           String
  descricao      String?
  valor          String?
  imagemUrl      String?
  ordem          Int           @default(0)

  @@index([listingId])
  @@index([professionalId])
}

model Review {
  id             String        @id @default(cuid())
  listingId      String?
  listing        Listing?      @relation(fields: [listingId], references: [id])
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id])
  authorId       String
  author         User          @relation(fields: [authorId], references: [id])
  estrelas       Int
  depoimento     String
  criadoEm       DateTime      @default(now())

  @@unique([authorId, listingId])
  @@unique([authorId, professionalId])
  @@index([listingId])
  @@index([professionalId])
}
